{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "epicdata::metadata YAML structur validator",
  "description": "Validating YAML metadata specification",
  "type": "object",
  "properties": {
    "options": {
      "description": "A list of options specifying study information, selecting workflow modules, and defining global variable defaults",
      "type": "object",
      "properties": {
        "data.name": {
          "description": "A short name for your dataset that is used for project and file names",
          "type": "string"
        },
        "id.var": {
          "description": "The name of the ID variable, which is used to identify observations",
          "type": "string",
          "pattern": "^([A-Za-z]{1}|\\.[A-Za-z._]{1})[A-Za-z0-9._]*$"
        },
        "id.pattern": {
          "description": "A Regular Expression that must be fulfilled for all values of the variable specified in id.var",
          "type": "string"
        },
        "id.list": {
          "description": "x",
          "type": "boolean"
        },
        "consent": {
          "description": "Indicate if informed consent will be checked",
          "type": "boolean"
        },
        "remove.vars": {
          "description": "Indicate if variables in the data that are missing from the metadata should be removed",
          "type": "boolean"
        },
        "vars.remove": {
          "description": "Indicate if variables in the data that are missing from the metadata should be removed",
          "type": "boolean"
        },
        "touch.na": {
          "description": "Indicate if NAs should be changed to missing codes",
          "type": "boolean"
        },
        "na.touch": {
          "description": "Indicate if NAs should be changed to missing codes",
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "remove.vars",
              "vars.remove"
            ]
          }
        },
        {
          "not": {
            "required": [
              "touch.na",
              "na.touch"
            ]
          }
        }
      ]
    },
    "var.list": {
      "description": "A list of all variables, where variable-specific information is provided",
      "type": "object",
      "patternProperties": {
        "^([A-Za-z]{1}|\\.[A-Za-z._]{1})[A-Za-z0-9._]*$": {
          "type": "object",
          "properties": {
            "type": {
              "description": "The variable type is the main variable characteristic and the only key that is always required",
              "type": "string",
              "enum": [
                "text",
                "num",
                "cat",
                "date",
                "time",
                "datetime"
              ]
            },
            "label": {
              "description": "x",
              "type": "string"
            },
            "group": {
              "description": "x",
              "type": "string",
              "pattern": "^([A-Za-z]{1}|\\.[A-Za-z._]{1})[A-Za-z0-9._]*$"
            },
            "touch.na": {
              "description": "Indicate if NAs should be changed to missing codes",
              "type": "boolean"
            },
            "na.touch": {
              "description": "Indicate if NAs should be changed to missing codes",
              "type": "boolean"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "num"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "properties": {
                  "less.than": {
                    "description": "x",
                    "type": "number"
                  },
                  "greater.than": {
                    "description": "x",
                    "type": "number"
                  },
                  "less.than.or.equal": {
                    "description": "x",
                    "type": "number"
                  },
                  "greater.than.or.equal": {
                    "description": "x",
                    "type": "number"
                  },
                  "lt": {
                    "description": "x",
                    "type": "number"
                  },
                  "gt": {
                    "description": "x",
                    "type": "number"
                  },
                  "lte": {
                    "description": "x",
                    "type": "number"
                  },
                  "gte": {
                    "description": "x",
                    "type": "number"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "cat"
                  }
                },
                "required": [
                  "type"
                ]
              },
              "then": {
                "properties": {
                  "cats": {
                    "description": "x",
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minLength": 1,
                    "uniqueItems": true
                  }
                }
              }
            },
            {
              "not": {
                "required": [
                  "greater.than",
                  "gt"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "greater.than",
                  "gte"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "greater.than",
                  "greater.than.or.equal"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "greater.than.or.equal",
                  "gt"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "greater.than.or.equal",
                  "gte"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "gt",
                  "gte"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "less.than",
                  "lt"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "less.than",
                  "lte"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "less.than",
                  "less.than.or.equal"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "less.than.or.equal",
                  "lt"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "less.than.or.equal",
                  "lte"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "lt",
                  "lte"
                ]
              }
            },
            {
              "not": {
                "required": [
                  "touch.na",
                  "na.touch"
                ]
              }
            }
          ],
          "required": [
            "type"
          ],
          "unevaluatedProperties": false
        }
      },
      "additionalProperties": false,
      "minProperties": 1
    },
    "var.groups": {
      "description": "A list of variable groups with information that applies to the group instead of individual variables",
      "type": "object",
      "patternProperties": {
        "^([A-Za-z]{1}|\\.[A-Za-z._]{1})[A-Za-z0-9._]*$": {
          "type": "object",
          "properties": {
            "touch.na": {
              "description": "Indicate if NAs should be changed to missing codes",
              "type": "boolean"
            },
            "na.touch": {
              "description": "Indicate if NAs should be changed to missing codes",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "allOf": [
            {
              "not": {
                "required": [
                  "touch.na",
                  "na.touch"
                ]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "na.codes": {
      "description": "A list of codes that will represent missing values in the processed data set",
      "type": "object",
      "patternProperties": {
        "^[1-9][0-9]{0,3}$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "contras": {
      "description": "A list of implausible combinations of values from two variables",
      "type": "array",
      "items": {
        "type": "string"
      },
      "minLength": 1,
      "uniqueItems": true
    },
    "import": {
      "description": "A list of related datasets, from which variables are made available for use in rules",
      "type": "object",
      "patternProperties": {
        "^([A-Za-z]{1}|\\.[A-Za-z._]{1})[A-Za-z0-9._]*$": {
          "type": "object",
          "properties": {
            "id": {
              "description": "",
              "type": "string"
            },
            "vars": {
              "description": "",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minLength": 1,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "vars"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "var.list"
  ],
  "additionalProperties": false
}

